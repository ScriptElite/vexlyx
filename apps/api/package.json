{
  "name": "@vexlyx/api",
  "version": "0.4.8",
  "private": true,
  "description": "Vexlyx API server (Fastify)",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --build",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .turbo tsconfig.tsbuildinfo",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:create-admin": "tsx prisma/create-admin.ts",
    "db:reencrypt": "tsx --env-file=.env prisma/reencrypt-secrets.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/formbody": "^9.0.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/redis": "^9.0.0",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "^6.9.0",
    "@vexlyx/shared": "workspace:*",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.1",
    "fastify": "^5.12.1",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^6.0.0",
    "nodemailer": "^10.0.15",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.9.0",
    "vitest": "^5.0.0"
  }
}
